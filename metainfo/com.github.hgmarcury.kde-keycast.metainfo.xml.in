<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.hgmarcury.kde-keycast</id>

  <name>KDE KeyCast</name>
  <summary>Keyboard and mouse visualizer for KDE Plasma on Wayland</summary>
  <url type="homepage">https://github.com/hgmarcury/kde-keycast</url>

  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      KDE KeyCast is a keyboard and mouse visualizer designed for KDE Plasma
      running on Wayland. It displays keyboard input, mouse buttons, and
      physical mouse wheel events in an unobtrusive on-screen overlay.
    </p>
    <p>
      KDE KeyCast includes a modified ShowMeTheKey backend that adds physical
      mouse wheel event detection.
    </p>
  </description>

  <launchable type="desktop-id">kde-keycast.desktop</launchable>

  <provides>
    <binary>kde-keycast</binary>
  </provides>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="@PROJECT_VERSION@" date="2026-10-05"/>
  </releases>
</component>
