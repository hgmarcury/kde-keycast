#!/bin/sh
set -e

case "$1" in
    purge)
        if [ -d /var/lib/kde-keycast/permissions ]; then
            rmdir --ignore-fail-on-non-empty /var/lib/kde-keycast/permissions
        fi

        if [ -d /var/lib/kde-keycast ]; then
            rmdir --ignore-fail-on-non-empty /var/lib/kde-keycast
        fi
        ;;
esac

exit 0
