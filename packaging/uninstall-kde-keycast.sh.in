#!/usr/bin/env bash

set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: Run this uninstaller with administrator privileges."
    echo "Usage: sudo $0"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="$(cd "$SCRIPT_DIR/.." && pwd)"

BINDIR="$SCRIPT_DIR"
DATADIR="$PREFIX/@CMAKE_INSTALL_DATAROOTDIR@"
LIBEXECDIR="$PREFIX/@CMAKE_INSTALL_LIBEXECDIR@"

USER_DATA_DIR=""

if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    USER_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"

    if [[ -z "$USER_HOME" || ! -d "$USER_HOME" ]]; then
        echo "ERROR: Could not determine the desktop user's home directory."
        echo "No application files or permissions have been removed."
        exit 1
    fi

    USER_XDG_DATA_HOME="$(
        sudo -u "$SUDO_USER" -H sh -c 'printf "%s" "${XDG_DATA_HOME:-$HOME/.local/share}"'
    )"

    if [[ "$USER_XDG_DATA_HOME" != /* ]]; then
        echo "ERROR: The desktop user's XDG_DATA_HOME is not an absolute path."
        echo "No application files or permissions have been removed."
        exit 1
    fi

    USER_DATA_DIR="$USER_XDG_DATA_HOME"
else
    echo "ERROR: Cannot reliably determine the desktop user."
    echo "Run this uninstaller with sudo from the desktop user's session."
    echo "No application files or permissions have been removed."
    exit 1
fi

echo "==> Uninstalling KDE KeyCast..."

KWIN_UNINSTALLER="$BINDIR/uninstall-kwin-kde-keycast"

if [[ ! -x "$KWIN_UNINSTALLER" ]]; then
    echo "ERROR: KWin uninstaller is missing:"
    echo "  $KWIN_UNINSTALLER"
    echo "No application files or permissions have been removed."
    exit 1
fi

if [[ -x "$KWIN_UNINSTALLER" ]]; then
    echo "==> Removing KDE KeyCast KWin integration..."

    if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        USER_UID="$(id -u "$SUDO_USER")"
        USER_RUNTIME_DIR="/run/user/$USER_UID"

        if ! sudo -u "$SUDO_USER" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_RUNTIME_DIR/bus" \
            XDG_RUNTIME_DIR="$USER_RUNTIME_DIR" \
            "$KWIN_UNINSTALLER"; then
            echo "ERROR: Could not remove the KWin integration."
            echo "No application files or permissions have been removed."
            exit 1
        fi
    else
        echo "ERROR: Cannot reliably determine the desktop user."
        echo "Run this uninstaller with sudo from the desktop user's session."
        echo "No application files or permissions have been removed."
        exit 1
    fi
fi

PERMISSION_REMOVER="$BINDIR/remove-kde-keycast-permissions"

if [[ ! -x "$PERMISSION_REMOVER" ]]; then
    echo "ERROR: Permission removal helper is missing:"
    echo "  $PERMISSION_REMOVER"
    echo "No application files have been removed."
    exit 1
fi

echo "==> Removing KDE KeyCast permissions..."

if ! "$PERMISSION_REMOVER" --apply; then
    echo "ERROR: Could not completely remove KDE KeyCast permissions."
    echo "The application files have been retained for recovery."
    exit 1
fi

if [[ -n "$USER_DATA_DIR" ]]; then
    echo "==> Removing KDE KeyCast user desktop integration..."

    rm -f \
        "$USER_DATA_DIR/applications/kde-keycast.desktop"
fi

echo "==> Removing KDE KeyCast files..."

rm -f \
    "$BINDIR/kde-keycast" \
    "$BINDIR/install-kwin-kde-keycast" \
    "$BINDIR/uninstall-kwin-kde-keycast" \
    "$BINDIR/uninstall-kde-keycast" \
    "$BINDIR/configure-kde-keycast-permissions" \
    "$BINDIR/remove-kde-keycast-permissions" \
    "$LIBEXECDIR/kde-keycast/showmethekey-cli" \
    "$DATADIR/applications/kde-keycast.desktop" \
    "$DATADIR/icons/hicolor/scalable/apps/keycast-light.svg" \
    "$DATADIR/icons/hicolor/scalable/apps/keycast-dark.svg" \
    "$DATADIR/metainfo/com.github.hgmarcury.kde-keycast.metainfo.xml" \
    "$DATADIR/polkit-1/actions/com.github.hgmarcury.kde-keycast.policy"

rm -rf \
    "$LIBEXECDIR/kde-keycast" \
    "$DATADIR/kde-keycast"

echo "==> KDE KeyCast uninstalled."
