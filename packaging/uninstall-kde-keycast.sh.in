#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="$(cd "$SCRIPT_DIR/.." && pwd)"

BINDIR="$SCRIPT_DIR"
DATADIR="$PREFIX/@CMAKE_INSTALL_DATAROOTDIR@"
LIBEXECDIR="$PREFIX/@CMAKE_INSTALL_LIBEXECDIR@"

echo "==> Uninstalling KDE KeyCast..."

USER_DATA_DIR=""

if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    USER_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    USER_DATA_DIR="${XDG_DATA_HOME:-$USER_HOME/.local/share}"
elif [[ "$(id -u)" -ne 0 ]]; then
    USER_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
fi

KWIN_UNINSTALLER="$BINDIR/uninstall-kwin-kde-keycast"

if [[ -x "$KWIN_UNINSTALLER" ]]; then
    echo "==> Removing KDE KeyCast KWin integration..."

    if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        USER_UID="$(id -u "$SUDO_USER")"
        USER_RUNTIME_DIR="/run/user/$USER_UID"

        if ! sudo -u "$SUDO_USER" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_RUNTIME_DIR/bus" \
            XDG_RUNTIME_DIR="$USER_RUNTIME_DIR" \
            "$KWIN_UNINSTALLER"; then
            echo "WARNING: Could not remove the KWin integration."
            echo "Continuing with KDE KeyCast file removal..."
        fi
    elif [[ "$(id -u)" -eq 0 ]]; then
        echo "WARNING: Cannot determine the desktop user."
        echo "Skipping KWin integration removal."
    else
        if ! "$KWIN_UNINSTALLER"; then
            echo "WARNING: Could not remove the KWin integration."
            echo "Continuing with KDE KeyCast file removal..."
        fi
    fi
fi

if [[ -n "$USER_DATA_DIR" ]]; then
    echo "==> Removing KDE KeyCast user desktop integration..."

    rm -f \
        "$USER_DATA_DIR/applications/kde-keycast.desktop"
fi

echo "==> Removing KDE KeyCast files..."

rm -f \
    "$BINDIR/kde-keycast" \
    "$BINDIR/install-kwin-kde-keycast" \
    "$BINDIR/uninstall-kwin-kde-keycast" \
    "$BINDIR/uninstall-kde-keycast" \
    "$BINDIR/configure-kde-keycast-permissions" \
    "$BINDIR/remove-kde-keycast-permissions" \
    "$LIBEXECDIR/kde-keycast/showmethekey-cli" \
    "$DATADIR/applications/kde-keycast.desktop" \
    "$DATADIR/icons/hicolor/scalable/apps/keycast-light.svg" \
    "$DATADIR/icons/hicolor/scalable/apps/keycast-dark.svg" \
    "$DATADIR/metainfo/com.github.hgmarcury.kde-keycast.metainfo.xml" \
    "$DATADIR/polkit-1/actions/com.github.hgmarcury.kde-keycast.policy"

rm -rf \
    "$LIBEXECDIR/kde-keycast" \
    "$DATADIR/kde-keycast"

echo "==> KDE KeyCast uninstalled."
