#!/usr/bin/env bash

set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: Run this uninstaller with administrator privileges."
    echo "Usage: sudo $0"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="$(cd "$SCRIPT_DIR/.." && pwd)"

BINDIR="$SCRIPT_DIR"
DATADIR="$PREFIX/@CMAKE_INSTALL_DATAROOTDIR@"
LIBEXECDIR="$PREFIX/@CMAKE_INSTALL_LIBEXECDIR@"
KWIN_EFFECT_DIR="@KDE_KEYCAST_KWIN_EFFECT_DIR@"

USER_DATA_DIR=""

if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    USER_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"

    if [[ -z "$USER_HOME" || ! -d "$USER_HOME" ]]; then
        echo "ERROR: Could not determine the desktop user's home directory."
        echo "No application files or permissions have been removed."
        exit 1
    fi

    USER_XDG_DATA_HOME="$(
        sudo -u "$SUDO_USER" -H sh -c 'printf "%s" "${XDG_DATA_HOME:-$HOME/.local/share}"'
    )"

    if [[ "$USER_XDG_DATA_HOME" != /* ]]; then
        echo "ERROR: The desktop user's XDG_DATA_HOME is not an absolute path."
        echo "No application files or permissions have been removed."
        exit 1
    fi

    USER_DATA_DIR="$USER_XDG_DATA_HOME"
else
    echo "ERROR: Cannot reliably determine the desktop user."
    echo "Run this uninstaller with sudo from the desktop user's session."
    echo "No application files or permissions have been removed."
    exit 1
fi

echo "==> Uninstalling KDE KeyCast..."

PERMISSION_REMOVER="$BINDIR/remove-kde-keycast-permissions"

if [[ ! -x "$PERMISSION_REMOVER" ]]; then
    echo "ERROR: Permission removal helper is missing:"
    echo "  $PERMISSION_REMOVER"
    echo "No application files have been removed."
    exit 1
fi

echo "==> Removing KDE KeyCast permissions..."

if ! "$PERMISSION_REMOVER" --apply; then
    echo "ERROR: Could not completely remove KDE KeyCast permissions."
    echo "The application files have been retained for recovery."
    exit 1
fi

if [[ -n "$USER_DATA_DIR" ]]; then
    echo "==> Removing KDE KeyCast user desktop integration..."

    rm -f \
        "$USER_DATA_DIR/applications/kde-keycast.desktop" \
        "$USER_DATA_DIR/icons/hicolor/scalable/apps/keycast-light.svg" \
        "$USER_DATA_DIR/icons/hicolor/scalable/apps/keycast-dark.svg"
fi

remove_kde_keycast_kwin_script() {
    local script_dir="$DATADIR/kwin/scripts/kde-keycast"
    local metadata="$script_dir/metadata.json"

    if [[ ! -e "$script_dir" && ! -L "$script_dir" ]]; then
        return 0
    fi

    if [[ -L "$script_dir" || ! -d "$script_dir" ]]; then
        echo "WARNING: Invalid KWin script directory."
        echo "         Leaving it untouched: $script_dir"
        return 0
    fi

    if [[ -L "$metadata" || ! -f "$metadata" ]]; then
        echo "WARNING: KWin script metadata is missing or invalid."
        echo "         Leaving the directory untouched: $script_dir"
        return 0
    fi

    if ! grep -Fq '"KPackageStructure": "KWin/Script"' "$metadata" ||
       ! grep -Fq '"Id": "kde-keycast"' "$metadata" ||
       ! grep -Fq '"Name": "KDE KeyCast"' "$metadata"; then
        echo "WARNING: KWin script metadata does not identify KDE KeyCast."
        echo "         Leaving the directory untouched: $script_dir"
        return 0
    fi

    echo "==> Removing verified KDE KeyCast KWin script..."
    rm -rf -- "$script_dir"
}

remove_kde_keycast_cursor_effect() {
    local plugin="$KWIN_EFFECT_DIR/kde-keycast-cursor.so"
    local marker="$KWIN_EFFECT_DIR/kde-keycast-cursor.installed"
    local expected="KDE KeyCast native KWin cursor effect"

    # No ownership marker: never remove an unverified plugin.
    if [[ ! -e "$marker" && ! -L "$marker" ]]; then
        if [[ -e "$plugin" || -L "$plugin" ]]; then
            echo "WARNING: Cursor effect found without an ownership marker."
            echo "         Leaving it untouched: $plugin"
        fi
        return 0
    fi

    # Reject symbolic links and unexpected marker types.
    if [[ -L "$marker" || ! -f "$marker" ]]; then
        echo "WARNING: Invalid cursor effect ownership marker."
        echo "         Leaving the effect untouched."
        return 0
    fi

    if ! grep -Fxq "$expected" "$marker"; then
        echo "WARNING: Cursor effect ownership marker does not match."
        echo "         Leaving the effect untouched."
        return 0
    fi

    # Never follow or remove a symbolic link in the plugin path.
    if [[ -L "$plugin" ]]; then
        echo "WARNING: Cursor effect is a symbolic link."
        echo "         Leaving it untouched: $plugin"
        return 0
    fi

    if [[ -e "$plugin" && ! -f "$plugin" ]]; then
        echo "WARNING: Cursor effect is not a regular file."
        echo "         Leaving it untouched: $plugin"
        return 0
    fi

    echo "==> Removing verified KDE KeyCast cursor effect..."

    rm -f -- "$plugin" "$marker"
}

remove_kde_keycast_kwin_script

remove_kde_keycast_cursor_effect

echo "==> Removing KDE KeyCast files..."

rm -f \
    "$BINDIR/kde-keycast" \
    "$BINDIR/install-kwin-kde-keycast" \
    "$BINDIR/uninstall-kwin-kde-keycast" \
    "$BINDIR/uninstall-kde-keycast" \
    "$BINDIR/configure-kde-keycast-permissions" \
    "$BINDIR/remove-kde-keycast-permissions" \
    "$LIBEXECDIR/kde-keycast/showmethekey-cli" \
    "$DATADIR/applications/kde-keycast.desktop" \
    "$DATADIR/icons/hicolor/scalable/apps/keycast-light.svg" \
    "$DATADIR/icons/hicolor/scalable/apps/keycast-dark.svg" \
    "$DATADIR/metainfo/com.github.hgmarcury.kde-keycast.metainfo.xml" \
    "$DATADIR/polkit-1/actions/com.github.hgmarcury.kde-keycast.policy"

rm -rf \
    "$LIBEXECDIR/kde-keycast" \
    "$DATADIR/kde-keycast"

echo "==> KDE KeyCast uninstalled."
