#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Marc G.
# SPDX-License-Identifier: GPL-3.0-or-later

set -Eeuo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

if [[ "$SCRIPT_DIR" == "/usr/lib/kde-keycast-appimage" ]]; then
    RULE_SOURCE="$SCRIPT_DIR/10-com.github.hgmarcury.kde-keycast.rules"
else
    RULE_SOURCE="$SCRIPT_DIR/../share/kde-keycast/polkit/10-com.github.hgmarcury.kde-keycast.rules"

    if [[ ! -f "$RULE_SOURCE" ]]; then
        RULE_SOURCE="$SCRIPT_DIR/../resources/polkit/10-com.github.hgmarcury.kde-keycast.rules"
    fi

    if [[ ! -f "$RULE_SOURCE" ]]; then
        RULE_SOURCE="@KDE_INSTALL_FULL_DATADIR@/kde-keycast/polkit/10-com.github.hgmarcury.kde-keycast.rules"
    fi
fi

RULE_DEST="/etc/polkit-1/rules.d/50-com.github.hgmarcury.kde-keycast.rules"
GROUP_NAME="kde-keycast"
STATE_DIR="/var/lib/kde-keycast/permissions"
MEMBERS_FILE="$STATE_DIR/members"
STATUS_MARKER="/var/lib/kde-keycast/permissions-configured"
USER_DATA_REGISTRY="/var/lib/kde-keycast/appimage-user-data-dir"

if [[ "${1:-}" == "--apply" ]]; then
    [[ "$(id -u)" -eq 0 ]] || {
        echo "ERROR: Se necesitan privilegios de administrador."
        exit 1
    }

    validate_state_dir() {
        local path="$1"
        local expected_mode="$2"

        if [[ -e "$path" || -L "$path" ]]; then
            [[ -d "$path" && ! -L "$path" ]] || {
                echo "ERROR: $path no es un directorio válido."
                echo "No se ha modificado ningún permiso."
                exit 1
            }

            [[ "$(stat -c '%u:%g:%a' -- "$path")" == "0:0:$expected_mode" ]] || {
                echo "ERROR: Propietario o permisos inesperados en $path."
                echo "Se esperaba root:root con modo $expected_mode."
                echo "No se ha modificado ningún permiso."
                exit 1
            }
        fi
    }

    validate_state_file() {
        local path="$1"
        local expected_mode="$2"

        if [[ -e "$path" || -L "$path" ]]; then
            [[ -f "$path" && ! -L "$path" ]] || {
                echo "ERROR: $path no es un archivo regular válido."
                echo "No se ha modificado ningún permiso."
                exit 1
            }

            [[ "$(stat -c '%u:%g:%a' -- "$path")" == "0:0:$expected_mode" ]] || {
                echo "ERROR: Propietario o permisos inesperados en $path."
                echo "Se esperaba root:root con modo $expected_mode."
                echo "No se ha modificado ningún permiso."
                exit 1
            }
        fi
    }

    # Validar todo el estado antes de eliminar reglas o cambiar grupos.
    validate_state_dir /var/lib/kde-keycast 755
    validate_state_dir "$STATE_DIR" 700

    validate_state_file "$STATE_DIR/group-created" 600
    validate_state_file "$STATE_DIR/rule-installed" 600
    validate_state_file "$MEMBERS_FILE" 600
    validate_state_file "$STATUS_MARKER" 644
    validate_state_file "$USER_DATA_REGISTRY" 644

    if [[ -e "$RULE_DEST" || -L "$RULE_DEST" ]]; then
        [[ -f "$RULE_DEST" && ! -L "$RULE_DEST" ]] || {
            echo "ERROR: La regla de Polkit no es un archivo regular:"
            echo "  $RULE_DEST"
            echo "No se ha modificado ningún permiso."
            exit 1
        }

        [[ "$(stat -c '%u:%g:%a' -- "$RULE_DEST")" == "0:0:644" ]] || {
            echo "ERROR: Propietario o permisos inesperados en $RULE_DEST."
            echo "Se esperaba root:root con modo 644."
            echo "No se ha modificado ningún permiso."
            exit 1
        }
    fi

    is_known_managed_rule() {
        if [[ -f "$RULE_SOURCE" ]] && cmp -s "$RULE_SOURCE" "$RULE_DEST"; then
            return 0
        fi

        cmp -s "$RULE_DEST" <(printf '%s\n' \
            '/*' \
            ' * SPDX-FileCopyrightText: 2026 Marc G.' \
            ' * SPDX-License-Identifier: GPL-3.0-or-later' \
            ' */' \
            '' \
            'polkit.addRule(function(action, subject) {' \
            '    if ((action.id === "com.github.hgmarcury.kde-keycast.backend" ||' \
            '         action.id === "com.github.hgmarcury.kde-keycast-appimage.backend") &&' \
            '        subject.isInGroup("kde-keycast") &&' \
            '        subject.local &&' \
            '        subject.active) {' \
            '        return polkit.Result.YES;' \
            '    }' \
            '});') && return 0

        cmp -s "$RULE_DEST" <(printf '%s\n' \
            '/*' \
            ' * SPDX-FileCopyrightText: 2026 Marc G.' \
            ' * SPDX-License-Identifier: GPL-3.0-or-later' \
            ' */' \
            '' \
            'polkit.addRule(function(action, subject) {' \
            '    if (action.id === "com.github.hgmarcury.kde-keycast.backend" &&' \
            '        subject.isInGroup("kde-keycast") &&' \
            '        subject.local &&' \
            '        subject.active) {' \
            '        return polkit.Result.YES;' \
            '    }' \
            '});')
    }

    # Comprobar la propiedad de la regla antes de cambiar cualquier grupo.
    if [[ -e "$RULE_DEST" ]]; then
        [[ -f "$STATE_DIR/rule-installed" ]] || {
            echo "ERROR: Existe una regla de Polkit, pero no consta que"
            echo "KDE KeyCast la instalara. Se conserva por seguridad:"
            echo "  $RULE_DEST"
            echo "No se ha modificado ningún permiso."
            exit 1
        }

        is_known_managed_rule || {
            echo "ERROR: La regla ha cambiado; se conserva por seguridad:"
            echo "  $RULE_DEST"
            echo "No se ha modificado ningún permiso."
            exit 1
        }
    fi

    # Eliminar únicamente una regla registrada y reconocida.
    if [[ -f "$STATE_DIR/rule-installed" ]]; then
        if [[ ! -e "$RULE_DEST" ]]; then
            rm -f -- "$STATE_DIR/rule-installed"
        elif is_known_managed_rule; then
            if rm -- "$RULE_DEST"; then
                if rm -f -- "$STATE_DIR/rule-installed"; then
                    echo "Regla de Polkit eliminada."
                else
                    echo "AVISO: La regla se eliminó, pero no se pudo retirar su registro."
                fi
            else
                echo "AVISO: No se pudo eliminar la regla de Polkit:"
                echo "  $RULE_DEST"
                echo "Se conserva el registro para poder reintentarlo."
            fi
        else
            echo "ERROR: La regla ha cambiado; se conserva por seguridad:"
            echo "  $RULE_DEST"
            echo "No se ha modificado ningún otro permiso."
            exit 1
        fi
    else
        echo "No consta que KDE KeyCast instalara la regla."
    fi

    # Procesar cada usuario y conservar los que no se hayan podido retirar.
    if [[ -f "$MEMBERS_FILE" ]]; then
        REMAINING_FILE="$(mktemp "$STATE_DIR/members.XXXXXX")"
        chmod 0600 "$REMAINING_FILE"

        while IFS= read -r user; do
            [[ -n "$user" ]] || continue

            if ! id "$user" >/dev/null 2>&1; then
                echo "AVISO: El usuario '$user' ya no existe."
                continue
            fi

            if ! getent group "$GROUP_NAME" >/dev/null; then
                echo "AVISO: El grupo '$GROUP_NAME' no existe."
                echo "Se conserva el registro de '$user' para revisión."
                printf '%s\n' "$user" >> "$REMAINING_FILE"
                continue
            fi

            if ! id -nG "$user" | tr ' ' '\n' | grep -Fxq "$GROUP_NAME"; then
                continue
            fi

            if gpasswd -d "$user" "$GROUP_NAME"; then
                echo "Se ha retirado '$user' del grupo."
            else
                echo "AVISO: No se pudo retirar '$user'; se conserva el registro."
                printf '%s\n' "$user" >> "$REMAINING_FILE"
            fi
        done < "$MEMBERS_FILE"

        if [[ -s "$REMAINING_FILE" ]]; then
            mv -- "$REMAINING_FILE" "$MEMBERS_FILE"
        else
            rm -f -- "$REMAINING_FILE" "$MEMBERS_FILE"
        fi
    fi

    # Eliminar el grupo solo si lo creó KDE KeyCast y está vacío.
    if [[ -f "$STATE_DIR/group-created" ]]; then
        if ! getent group "$GROUP_NAME" >/dev/null; then
            if [[ ! -s "$MEMBERS_FILE" ]]; then
                if ! rm -f -- "$STATE_DIR/group-created" ||
                   [[ -e "$STATE_DIR/group-created" || -L "$STATE_DIR/group-created" ]]; then
                    echo "AVISO: No se pudo retirar el registro del grupo."
                fi
            else
                echo "AVISO: El grupo no existe, pero quedan usuarios registrados."
                echo "Se conserva el registro del grupo para revisión."
            fi
        else
            GROUP_GID="$(getent group "$GROUP_NAME" | cut -d: -f3)"

            if [[ -z "$(getent group "$GROUP_NAME" | cut -d: -f4)" ]] &&
               ! getent passwd | awk -F: -v gid="$GROUP_GID" '$4 == gid { found=1 } END { exit !found }'; then
                if groupdel "$GROUP_NAME"; then
                    if rm -f -- "$STATE_DIR/group-created" &&
                       [[ ! -e "$STATE_DIR/group-created" && ! -L "$STATE_DIR/group-created" ]]; then
                        echo "Grupo $GROUP_NAME eliminado."
                    else
                        echo "AVISO: El grupo se eliminó, pero no se pudo retirar su registro."
                    fi
                else
                    echo "AVISO: No se pudo eliminar el grupo; se conserva su registro."
                fi
            else
                echo "El grupo se conserva porque aún tiene miembros"
                echo "o es el grupo principal de algún usuario."
            fi
        fi
    fi

    # Borrar los registros solo cuando ya no quede trabajo pendiente.
    if [[ -d "$STATE_DIR" ]] &&
       [[ -z "$(find "$STATE_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
        rmdir -- "$STATE_DIR"
        rmdir -- "$(dirname "$STATE_DIR")" 2>/dev/null || true
    fi

    PENDING=0

    if [[ -e "$RULE_DEST" ]]; then
        echo "PENDIENTE: La regla de Polkit sigue presente: $RULE_DEST"
        PENDING=1
    fi

    if [[ -d "$STATE_DIR" ]] &&
       [[ -n "$(find "$STATE_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
        echo "PENDIENTE: Quedan registros en $STATE_DIR"
        PENDING=1
    fi

    if (( PENDING )); then
        echo "La retirada no se ha completado; revisa los avisos anteriores."
        exit 1
    fi

    if [[ -e "$STATUS_MARKER" ]] && ! rm -f -- "$STATUS_MARKER"; then
        echo "PENDIENTE: No se pudo retirar el indicador de estado."
        exit 1
    fi

    if [[ -e "$USER_DATA_REGISTRY" ]] &&
        ! rm -f -- "$USER_DATA_REGISTRY"; then
        echo "PENDIENTE: No se pudo retirar el registro del directorio de usuario."
        exit 1
    fi

    rmdir -- "$(dirname "$STATE_DIR")" 2>/dev/null || true

    echo "Permisos registrados de KDE KeyCast retirados."
    exit 0
fi

if [[ "$(id -u)" -eq 0 ]]; then
    echo "Ejecuta este script desde la sesión del usuario, no como root."
    exit 1
fi

echo "Se retirarán los permisos sin autenticación de KDE KeyCast."
echo "Se intentará quitar únicamente las pertenencias registradas"
echo "por su instalador y la regla que instaló originalmente."
echo "Las reglas modificadas y las pertenencias previas se conservarán."
echo

read -r -p "¿Quieres continuar? [s/N] " answer

case "$answer" in
    s|S|si|SI|Si|sí|Sí|sÍ)
        exec sudo bash "$0" --apply
        ;;
    *)
        echo "No se han modificado los permisos."
        exit 0
        ;;
esac
